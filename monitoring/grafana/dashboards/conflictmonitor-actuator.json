      "options": {
        "legend": { "calcs": ["max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true, "sortBy": "Max", "sortDesc": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Process Latency Max by Topology",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (topology, application_id) (cm_streams_process_latency_max_ms{job=~\"$job\", application=~\"$application\", topology=~\"$topology\"})",
          "legendFormat": "{{topology}}",
          "refId": "A"
        }
      ]
    },
    {
