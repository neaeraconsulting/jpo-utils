        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Conflict Monitor Micrometer metrics from /actuator/prometheus: JVM/process/system and cm_streams_* topology compute gauges.",
