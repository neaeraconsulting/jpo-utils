    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "CM /health/streams/cpu",
      "tooltip": "Ranked topology CPU summary JSON",
      "type": "link",
      "url": "http://localhost:8082/health/streams/cpu"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Prometheus scrape (/health/prometheus)",
      "type": "link",
      "url": "http://localhost:8082/health/prometheus"
    }
