        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Process Latency Avg by Topology",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg by (topology, application_id) (cm_streams_process_latency_avg_ms{job=~\"$job\", application=~\"$application\", topology=~\"$topology\"})",
          "legendFormat": "{{topology}} ({{application_id}})",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Records processed per second by topology (Kafka Streams process-rate sum)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
